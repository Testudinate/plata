# Шаблон. Настоящий .env в git не коммитится — см. .gitignore.
# Пустых дефолтов у секретов нет: без значения сервис не стартует.

# --- Snowflake -------------------------------------------------------------
# ИДЕНТИФИКАТОР АККАУНТА, а не account locator. Locator из CURRENT_ACCOUNT()
# (здесь DX31435) сам по себе НЕ маршрутизируется: коннектор соберёт хост
# DX31435.snowflakecomputing.com и получит 404 на /session/v1/login-request —
# ошибка выглядит как сетевая, хотя дело в имени.
# Правильная форма — <организация>-<аккаунт>, оба видны в URL Snowsight:
# app.snowflake.com/uowyqsk/mx50271/ -> uowyqsk-mx50271
# Запасная форма, если первая не проходит: DX31435.ap-south-1.aws
SNOWFLAKE_ACCOUNT=uowyqsk-mx50271
SNOWFLAKE_USER=PLATA_COPILOT_SVC
# Роль отвечающая: читает витрины и контекст-слой, писать не может ничем.
SNOWFLAKE_ROLE=LLM_AGENT_RO
# Роль журнальная: INSERT в AGENT_RUN_LOG и UPDATE двух колонок ALERT_LOG.
# Риск-данных не видит. Совмещать с предыдущей нельзя.
SNOWFLAKE_WRITER_ROLE=COPILOT_WRITER
SNOWFLAKE_WAREHOUSE=WH_COPILOT
# Путь к ключу ВНУТРИ контейнера и путь на хосте для монтирования.
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_HOST_PATH=/opt/plata-copilot/secrets/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Агент в аккаунте ------------------------------------------------------
COPILOT_AGENT=RISK_GOV.AGENT.RISK_COPILOT
# Прогон агента — это несколько шагов: разрешение метрики, поиск по документации,
# один-два запроса к витрине. Типично 20-60 секунд, под нагрузкой дольше:
# warehouse XSMALL, и параллельный прогон eval из 16 вопросов занимает его целиком.
# 90 секунд оказалось мало — вопрос из чата падал по таймауту, пока шёл регресс.
COPILOT_QUERY_TIMEOUT=180

# --- API -------------------------------------------------------------------
# Длинная случайная строка: openssl rand -hex 32
COPILOT_API_KEY=

# --- Telegram --------------------------------------------------------------
TG_BOT_TOKEN=
# Обязателен. Пустой список = сервис не стартует: бот — публичная поверхность.
TG_ALLOWED_CHAT_IDS=
# Куда сыпать алерты автоматически. 0 или пусто — автодоставка выключена.
TG_ALERT_CHAT_ID=
ALERT_POLL_SECONDS=300

# --- Трейсинг (необязательно) ---------------------------------------------
# Без всех трёх значений трейсинг выключается целиком и ничего не ломает.
# Если Langfuse поднят соседним стеком, идти к нему надо по имени сервиса
# в общей сети llm-shared, а НЕ по 127.0.0.1: внутри контейнера это его
# собственная петля, а не хост.
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Стоимость токенов агента. Ставки CORTEX_AGENTS в RATE_SHEET_DAILY нет —
# Snowflake пока не тарифицирует их отдельной строкой. Пока значение пусто,
# Langfuse показывает только токены и НЕ показывает деньги: выдуманная цена
# хуже отсутствующей, потому что $0.00 неотличим от «вызов ничего не стоил».
# Когда ставка появится в биллинге, впишите её сюда в USD за 1 млн токенов.
CORTEX_USD_PER_1M_TOKENS=
