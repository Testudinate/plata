# Шаблон. Настоящий .env в git не коммитится — см. .gitignore.
# Пустых дефолтов у секретов нет: без значения сервис не стартует.

# --- Snowflake -------------------------------------------------------------
SNOWFLAKE_ACCOUNT=DX31435
SNOWFLAKE_USER=PLATA_COPILOT_SVC
# Роль отвечающая: читает витрины и контекст-слой, писать не может ничем.
SNOWFLAKE_ROLE=LLM_AGENT_RO
# Роль журнальная: INSERT в AGENT_RUN_LOG и UPDATE двух колонок ALERT_LOG.
# Риск-данных не видит. Совмещать с предыдущей нельзя.
SNOWFLAKE_WRITER_ROLE=COPILOT_WRITER
SNOWFLAKE_WAREHOUSE=WH_COPILOT
# Путь к ключу ВНУТРИ контейнера и путь на хосте для монтирования.
SNOWFLAKE_PRIVATE_KEY_PATH=/secrets/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_HOST_PATH=/opt/plata-copilot/secrets/snowflake_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Агент в аккаунте ------------------------------------------------------
COPILOT_AGENT=RISK_GOV.AGENT.RISK_COPILOT
COPILOT_QUERY_TIMEOUT=90

# --- API -------------------------------------------------------------------
# Длинная случайная строка: openssl rand -hex 32
COPILOT_API_KEY=

# --- Telegram --------------------------------------------------------------
TG_BOT_TOKEN=
# Обязателен. Пустой список = сервис не стартует: бот — публичная поверхность.
TG_ALLOWED_CHAT_IDS=
# Куда сыпать алерты автоматически. 0 или пусто — автодоставка выключена.
TG_ALERT_CHAT_ID=
ALERT_POLL_SECONDS=300

# --- Трейсинг (необязательно) ---------------------------------------------
# Без всех трёх значений трейсинг выключается целиком и ничего не ломает.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
